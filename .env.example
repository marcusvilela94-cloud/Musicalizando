# Supabase (Project Settings > API). No navegador vai só a chave anon/publishable (a service_role fica só no servidor, lá embaixo).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Só para rodar as migrações (npm run db:migrate). NUNCA use no app nem na Vercel.
# Supabase > Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco)
SUPABASE_DB_URL=postgresql://postgres.SEU-REF:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Biblioteca (/biblioteca): senha da página e a chave service_role, usadas SÓ
# pelas rotas do servidor (/api/biblioteca). Nunca use NEXT_PUBLIC_ nelas.
BIBLIOTECA_PASSWORD=escolha-uma-senha
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
