# Copie este arquivo para separador/.env e preencha. O .env NÃO vai para o Git.
# A chave service_role dá acesso total ao banco: use SÓ aqui (nunca na Vercel nem no site).
# Supabase > Project Settings > API Keys > "service_role" (ou a "secret key" sb_secret_...).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE-AQUI-A-CHAVE-SERVICE-ROLE

# Opcionais
CACHE_LIMITE_MB=200
INTERVALO_FILA_SEGUNDOS=5
# faixa com volume abaixo de (mistura + este valor) em dB é marcada como "sem conteúdo"
LIMIAR_SILENCIO_DB=-24
MP3_KBPS=64
