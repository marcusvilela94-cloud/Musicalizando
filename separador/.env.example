# Copie este arquivo para separador/.env e preencha. O .env NÃO vai para o Git.
# O separador NÃO usa chave do Supabase: fala só com o jogo (rotas /api/separador/*).

# Endereço do jogo e o token dos separadores (o mesmo SEPARADOR_TOKEN da Vercel)
JOGO_URL=https://musicalizando-phi.vercel.app
SEPARADOR_TOKEN=COLE-AQUI-O-SEPARADOR-TOKEN
# Nome que aparece na configuração do jogo
SEPARADOR_NOME=PC-Marcus

# Opcionais
CACHE_LIMITE_MB=200
INTERVALO_FILA_SEGUNDOS=5
# faixa com volume abaixo de (mistura + este valor) em dB é marcada como "sem conteúdo"
# (medido: guitarra de verdade fica entre -9 e -13 dB; sem guitarra, -18 a -28 dB)
LIMIAR_SILENCIO_DB=-16
MP3_KBPS=64
